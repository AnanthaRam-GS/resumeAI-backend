# Example environment variables for ResumeAI backend
# Copy to .env and fill values before running locally

# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/resumeai_dev

# Auth
JWT_SECRET=replace-with-32-char-min-secret
JWT_EXPIRES_IN=7d

# AWS (S3) - used for storing generated PDFs
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# LLM providers
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
# ResumeAI Backend environment template
# Copy this file to .env and provide real values locally.

PORT=3000
NODE_ENV=development

# Option A: Homebrew/local PostgreSQL
DATABASE_URL=postgresql://resumeai:resumeai_password@localhost:5432/resumeai_dev
# Option B: Docker PostgreSQL
# DATABASE_URL=postgresql://resumeai:resumeai_password@localhost:5433/resumeai_dev

# Option A: Homebrew/local PostgreSQL
TEST_DATABASE_URL=postgresql://resumeai:resumeai_password@localhost:5432/resumeai_test
# Option B: Docker PostgreSQL
# TEST_DATABASE_URL=postgresql://resumeai:resumeai_password@localhost:5433/resumeai_test

JWT_SECRET=
JWT_EXPIRES_IN=7d

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

GROQ_API_KEY=
GEMINI_API_KEY=
