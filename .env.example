# ════════════════════════════════════════════════════════════
# ResumeAI Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Database (Supabase PostgreSQL) ──────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres
DATABASE_SSL=true

# ── Authentication ───────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHARACTER_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d

# ── AWS S3 ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=resumeai-assets-dev

# ── AI Services ──────────────────────────────────────────────
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_API_KEY
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# ── File Upload ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ── Signed URLs ──────────────────────────────────────────────
SIGNED_URL_EXPIRY_SECONDS=900