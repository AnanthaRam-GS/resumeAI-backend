{
  "name": "resumeai-backend",
  "version": "1.0.0",
  "packageManager": "pnpm@11.8.0",
  "description": "ResumeAI MVP Backend API",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "env:validate": "node scripts/validate-env-example.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "db:docker:up": "docker compose up -d postgres",
    "db:docker:down": "docker compose down",
    "db:docker:logs": "docker compose logs -f postgres",
    "db:docker:reset": "docker compose down -v && docker compose up -d postgres",
    "db:docker:connect": "psql postgresql://resumeai:resumeai_password@localhost:5434/resumeai_dev",
    "db:docker:test:connect": "psql postgresql://resumeai:resumeai_password@localhost:5434/resumeai_test",
    "db:local:setup": "bash scripts/setup-local-postgres.sh",
    "db:local:init": "pnpm db:local:setup && pnpm db:migrate && pnpm db:seed && pnpm db:check",
    "db:supabase:init": "pnpm db:migrate && pnpm db:check",
    "db:docker:init": "pnpm db:docker:up && USE_SUPABASE=false LOCAL_DATABASE_URL=postgresql://resumeai:resumeai_password@localhost:5434/resumeai_dev pnpm db:wait && USE_SUPABASE=false LOCAL_DATABASE_URL=postgresql://resumeai:resumeai_password@localhost:5434/resumeai_dev pnpm db:migrate && USE_SUPABASE=false LOCAL_DATABASE_URL=postgresql://resumeai:resumeai_password@localhost:5434/resumeai_dev pnpm db:seed && USE_SUPABASE=false LOCAL_DATABASE_URL=postgresql://resumeai:resumeai_password@localhost:5434/resumeai_dev pnpm db:check",
    "db:local:connect": "psql postgresql://resumeai:resumeai_password@localhost:5432/resumeai_dev",
    "db:test:connect": "psql postgresql://resumeai:resumeai_password@localhost:5432/resumeai_test",
    "db:wait": "tsx scripts/wait-for-db.ts",
    "db:check": "tsx scripts/check-db-connection.ts",
    "s3:check": "tsx scripts/smoke-test-s3.ts",
    "db:diagnose": "node scripts/diagnose-supabase.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:seed": "tsx scripts/seed-local-db.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@aws-sdk/s3-request-presigner": "^3.1058.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@google/generative-ai": "^0.24.1",
    "@octokit/rest": "^22.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.2",
    "computer-modern": "0.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-raw-body": "^5.0.0",
    "groq-sdk": "^1.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "node-cron": "^4.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "posthog-node": "^5.39.0",
    "puppeteer": "^25.1.0",
    "resend": "^6.16.0",
    "uuid": "^14.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "msgpackr-extract"
    ]
  }
}
